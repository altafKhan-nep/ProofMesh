# GitHub personal access token (for deterministic ingestion)
GITHUB_TOKEN=

# Postgres (Neon / Railway / Supabase)
DATABASE_URL=

# Redis (Upstash) — omit to run analyses in-process
REDIS_URL=

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=

# Solana issuer keypair (must match ISSUER_ADDRESS in apps/api/src/routes.ts)
SOLANA_KEYPAIR_PATH=
SOLANA_RPC_URL=

# Optional LLM reviewer/skeptic. Omit for deterministic-only demo mode.
LLM_PROVIDER=gemini
LLM_API_KEY=
